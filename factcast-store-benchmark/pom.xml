<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.factcast</groupId>
    <artifactId>factcast</artifactId>
    <version>0.12.7-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>factcast-store-benchmark</artifactId>
  <packaging>pom</packaging>
  <name>${project.groupId}:${project.artifactId}</name>
  <properties>
    <sonar.skip>true</sonar.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <benchmark.python>python3</benchmark.python>
    <benchmark.venv>/tmp/agents/factcast-store-benchmark-venv</benchmark.venv>
    <!-- execution should be manual only -->
    <skipTests>true</skipTests>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <skip>${skipTests}</skip>
          <workingDirectory>${project.basedir}/concurrent-publish</workingDirectory>
        </configuration>
        <executions>
          <execution>
            <id>python-environment</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>generate-test-resources</phase>
            <configuration>
              <executable>${benchmark.python}</executable>
              <arguments>
                <argument>-m</argument>
                <argument>venv</argument>
                <argument>${benchmark.venv}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>python-dependencies</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>process-test-resources</phase>
            <configuration>
              <executable>${benchmark.venv}/bin/python</executable>
              <arguments>
                <argument>-m</argument>
                <argument>pip</argument>
                <argument>install</argument>
                <argument>--disable-pip-version-check</argument>
                <argument>--quiet</argument>
                <argument>--cache-dir</argument>
                <argument>/tmp/agents/factcast-store-benchmark-pip-cache</argument>
                <argument>-r</argument>
                <argument>${project.basedir}/concurrent-publish/requirements.txt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>python-tests</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <executable>${benchmark.venv}/bin/python</executable>
              <arguments>
                <argument>-B</argument>
                <argument>-m</argument>
                <argument>unittest</argument>
                <argument>discover</argument>
                <argument>-b</argument>
                <argument>-s</argument>
                <argument>${project.basedir}/concurrent-publish</argument>
                <argument>-p</argument>
                <argument>test_*.py</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
